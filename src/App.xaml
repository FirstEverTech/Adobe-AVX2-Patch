<Application
    x:Class="AdobeAVX2Patch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <!-- Zasoby stylów dla motywów -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Motyw jasny -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="White"/>
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="Black"/>
                    <SolidColorBrush x:Key="ScrollViewerBackgroundBrush" Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="ScrollViewerBorderBrush" Color="#FFCCCCCC"/>
                </ResourceDictionary>

                <!-- Motyw ciemny -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1E1E1E"/>
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="White"/>
                    <SolidColorBrush x:Key="ScrollViewerBackgroundBrush" Color="#FF333333"/>
                    <SolidColorBrush x:Key="ScrollViewerBorderBrush" Color="#FF555555"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>